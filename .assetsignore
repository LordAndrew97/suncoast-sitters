# ============================================================================
# .assetsignore — qué NO se sube a Cloudflare.
#
# Sin este fichero, `wrangler deploy` publicaría la carpeta entera, incluidos
# los borradores de legal/ y las notas internas. Cualquiera podría leerlos.
# Un patrón por línea, sintaxis de .gitignore.
# ============================================================================

# Herramientas y documentación internas
check.js
README.md
**/node_modules
node_modules/
node_modules/**
**/.DS_Store
src/
src/**
tests/
tests/**
migrations/
migrations/**
docs/
docs/**
coverage/
coverage/**
package.json
package-lock.json
tsconfig.json
vitest.config.mts
worker-configuration.d.ts
.dev.vars*

# Borradores legales y notas para vosotras dos. NO son públicos.
legal/
legal/**
photos/README.md

# Configuración de despliegue
wrangler.jsonc
.assetsignore
.gitignore
**/.git
.git/**
.wrangler/
.wrangler/**

# Sólo para GitHub Pages: aquí no hacen nada
.nojekyll
CNAME.example
CNAME

# Red de seguridad. Lo mismo que bloquea .gitignore: si un informe, un
# formulario firmado o una hoja de contactos acaba en la carpeta por error,
# que no se publique de todas formas.
private/
private/**
sensitive/
sensitive/**
photos/sitters/
photos/sitters/**
photos/*-portrait.*
*-references.*
*-background-check.*
*-background_check.*
*-signed.pdf
*.csv
*.xlsx
.env
.env.*
.DS_Store
